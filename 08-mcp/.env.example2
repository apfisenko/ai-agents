TELEGRAM_BOT_TOKEN=ваш_токен_бота
OPEN_API_KEY=ваш_ключ_openrouter
OPEN_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
SYSTEM_PROMPT_PATH=prompts/system.txt
LLM_MAX_COMPLETION_TOKENS=1024
RETRIEVER_K=5

#ќпционально, если нужно не дефолты:

SHOW_SOURCES=false
# EMBEDDING_MODEL=openai/text-embedding-3-small

#√ибрид (BM25 + вектор, без реранка):

RAG_RETRIEVAL_MODE=hybrid
HYBRID_SEMANTIC_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5
# BM25_K=5
# SEMANTIC_K=5

#hybrid_rerank Ч к минимуму выше добавьте модель cross-encoder, иначе конфиг упадЄт при старте:
RAG_RETRIEVAL_MODE=hybrid_rerank
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

#Ћокальные эмбеддинги (HF) вместо API дл€ индекса:

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-base
