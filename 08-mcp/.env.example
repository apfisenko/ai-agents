# Скопируйте в .env и задайте значения. Не коммитьте .env.

# --- Прокси / VPN (если без этого бот не доходит до api.telegram.org / OpenRouter) ---
# Укажите URL с схемой или только хост:порт (будет добавлено http://):
#   HTTPS_PROXY=http://127.0.0.1:11301   (часто с netsh 11301->реальный_порт; см. ReadMe)
#   HTTPS_PROXY=http://127.0.0.1:1301
# Один .env: и `uv run`, и Docker. В Docker тот же HTTPS_PROXY указывает на прокси на Windows; при ClientProxyConnectionError
# — ReadMe (Allow LAN, netsh portproxy). AIDD_DOCKER_DIRECT_NETWORK в docker-compose — только если в контейнере к Telegram
# путь без прокси, а в .env прокси оставлен ради `uv run` на хосте.
# AIDD_WINDOWS_PROXY_HOST: при Docker+wsl + ошибке 172.17.0.1 — IP Windows из: PowerShell: .\make.ps1 docker-windows-host-ip
# AIDD_DOCKER_DIRECT_NETWORK=1: только в docker-compose, если в контейнере без прокси, а .env с прокси — для `uv run`
HTTPS_PROXY=
HTTP_PROXY=
AIDD_DOCKER_DIRECT_NETWORK=
AIDD_WINDOWS_PROXY_HOST=

# Hugging Face Hub (CrossEncoder / HF embeddings): в коде подняты дефолты до 120 с (иначе часто Read timeout=10).
# При очень медленном канале или MITM увеличьте: HF_HUB_ETAG_TIMEOUT=180  HF_HUB_DOWNLOAD_TIMEOUT=180

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPEN_API_KEY=your_openrouter_key
LLM_MODEL=openai/gpt-4o-mini
# Опционально: отдельная модель для шага query transform в RAG; если не задано — используется LLM_MODEL
# LLM_QUERY_TRANSFORM_MODEL=openai/gpt-4o-mini
OPEN_BASE_URL=https://openrouter.ai/api/v1

# --- Режим retrieval и эмбеддинги (docs/vision.md, конфигурация) ---
# RAG_RETRIEVAL_MODE: semantic | hybrid | hybrid_rerank (по умолчанию semantic).
#   semantic — только векторный поиск (SEMANTIC_K / RETRIEVER_K).
#   hybrid — EnsembleRetriever: семантика + BM25 на тех же чанках; веса HYBRID_*.
#   hybrid_rerank — как hybrid, но пул кандидатов до BERT cross-encoder и обрезка до RERANK_TOP_K.
# RAG_RETRIEVAL_MODE=semantic
# Провайдер эмбеддингов для индекса: openai (OpenRouter / OpenAI-compatible API) | huggingface (локально)
# EMBEDDING_PROVIDER=openai
# При huggingface укажите id с Hugging Face, не openai/text-embedding-*:
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Топ-K семантического ретривера; если не задано — берётся RETRIEVER_K
# SEMANTIC_K=5
# Топ-K для BM25 (гибрид; по умолчанию 5)
# BM25_K=5
# Веса EnsembleRetriever (сумма 1.0; проверяются в режимах hybrid / hybrid_rerank)
# HYBRID_SEMANTIC_WEIGHT=0.5
# HYBRID_BM25_WEIGHT=0.5
# Cross-encoder (sentence-transformers); обязателен при RAG_RETRIEVAL_MODE=hybrid_rerank
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniFM-L-12-v2
# Пул кандидатов до реранка и сколько документов после реранка в контекст
# RERANK_CANDIDATE_POOL=20
# RERANK_TOP_K=5

# Топ-K документов для retriever (RAG): базовое K; дублируется SEMANTIC_K, если SEMANTIC_K не задан
RETRIEVER_K=5
# Показывать в ответе строку с использованными документами (файл, страницы). true / 1 / yes — включено
SHOW_SOURCES=false

# --- MCP: сервер mcp-bank-agent (streamable HTTP, docs/vision.md §12) ---
# Порядок: терминал 1 — make run-mcp-bank (или .\make.ps1 run-mcp-bank); терминал 2 — make run.
# Остановка MCP: make stop-mcp-bank | .\make.ps1 stop-mcp-bank (по порту из MCP_BANK_PORT или из URL ниже).
# Проверка без бота: make check-mcp-bank | .\make.ps1 check-mcp-bank (читает URL из .env, JSON и код выхода 0/1).
# В Telegram: /mcp_status — доступен ли MCP и какие инструменты (если MCP_BANK_ENABLED не false).
# По умолчанию бот пытается загрузить инструменты MCP; при ошибке — warning в логе, работа только с rag_search + convert_currency.
# Отключить попытку подключения: MCP_BANK_ENABLED=false
# URL эндпоинта MCP (путь /mcp). В Docker до хоста: http://host.docker.internal:8000/mcp
# MCP_BANK_STREAMABLE_HTTP_URL=http://127.0.0.1:8000/mcp
# Порт для make stop-mcp-bank (если не задан — из URL выше или 8000). Совпадает с MCP_BANK_PORT сервера mcp-bank-agent.
# MCP_BANK_PORT=8000

# --- LangSmith / трейсинг LangChain (опционально, docs/vision.md §9 и «Мониторинг…», п. 2) ---
# Прогоны RAG уходят в проект LangSmith без правок цепочки: клиент читает env при старте процесса.
# Если ключ и TRACING выключены / не заданы — работа бота без изменений.
# Включить трейсинг (достаточно true; поддерживаются и префикс LANGCHAIN_*, см. LangSmith SDK):
# LANGSMITH_TRACING_V2=true
# Ключ LangSmith / LangChain (формат «Bearer» не нужен — только значение ключа):
# LANGSMITH_API_KEY=your_langsmith_api_key
# Имя проекта в LangSmith для группировки трейсов (если не задано — дефолт клиента LangSmith):
# LANGSMITH_PROJECT=aidd-bot
# При EU-instance / self-hosted задайте базовый URL API (см. документацию LangSmith):
# LANGSMITH_ENDPOINT=https://...
#
# Выгрузка датасета (`make dataset-upload`, docs/vision.md §10): имя набора в LangSmith и базовое имя JSON в datasets/
# LANGSMITH_DATASET=06-rag-qa-dataset
# Совместимость со старыми .env: то же, что LANGSMITH_DATASET — LANGSMITH_DATASET_NAME
# LANGSMITH_DATASET_DESCRIPTION=Q&A для оценки RAG (aidd)

# --- RAGAS / команда Telegram /evaluate_dataset (docs/vision.md §10 п.4) ---
# Прогон вызывает ту же retrieval-цепочку и ретривер, что и бот сейчас (режим из RAG_RETRIEVAL_MODE и индекс).
# Нужны LANGSMITH_API_KEY и датасет в LangSmith (имя LANGSMITH_DATASET; загрузка: make dataset-upload).
# LLM для метрик RAGAS (OpenRouter id; по умолчанию совпадает с LLM_MODEL):
# RAGAS_LLM_MODEL=openai/gpt-4o-mini
# Лимит завершения для вызовов LLM внутри RAGAS (при LLMDidNotFinishException увеличьте; по умолчанию = LLM_MAX_COMPLETION_TOKENS):
# RAGAS_LLM_MAX_COMPLETION_TOKENS=4096
#
# Эмбеддинги для RAGAS — отдельно от пайплайна индексации: RAGAS_EMBEDDING_PROVIDER + RAGAS_EMBEDDING_MODEL.
# Если переменные не заданы, провайдер и модель подставляются из EMBEDDING_* (см. config.py).
#   openai — тот же OpenRouter base URL и OPEN_API_KEY, модель например OpenAI через префикс openai/:
# RAGAS_EMBEDDING_PROVIDER=openai
# RAGAS_EMBEDDING_MODEL=openai/text-embedding-3-small
#   huggingface — локально sentence-transformers (подходит для офлайна метрик без API эмбеддингов):
# RAGAS_EMBEDDING_PROVIDER=huggingface
# RAGAS_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Полоса RAGAS «Evaluating» по умолчанию выключена; 1 — включить tqdm (удобно в обычном терминале).
# RAGAS_SHOW_PROGRESS=1
# Параллельные задачи RAGAS (осторожно с лимитами API; по умолчанию в коде 1).
# RAGAS_MAX_WORKERS=2
# Число примеров за один прогон (по умолчанию в коде 30; all — весь набор, см. EVAL_MAX_EXAMPLES в evaluation.py)
# EVAL_MAX_EXAMPLES=30

# --- Регрессия (ит.15 / smoke): полный .env как у бота ---
# make smoke-rag-chain (или .\make.ps1 smoke-rag-chain) — индекс + один RAG-ответ; смените RAG_RETRIEVAL_MODE
# и перезапустите для проверки semantic / hybrid / hybrid_rerank. SHOW_SOURCES=true — в лог выведется превью источников.
# Быстрая проверка только индекса + векторного поиска: make smoke-index (OpenAI-эмбеддинги в скрипте зашиты как openai).

# Модель эмбеддингов для RAG (OpenRouter / OpenAI-compatible). По умолчанию в коде: openai/text-embedding-3-small
# EMBEDDING_MODEL=openai/text-embedding-3-small
# Индексация (эмбеддинги): таймаут HTTP в секундах (по умолчанию 180), размер батча (по умолчанию 64), число ретраев (по умолчанию 5)
# EMBEDDING_REQUEST_TIMEOUT=240
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_MAX_RETRIES=8
# Опционально: каталог с PDF/JSON для RAG (иначе ищется папка data/ от cwd вверх)
# DATA_DIR=./data
# Максимум токенов в ответе модели (chat completions: max_tokens в API). Обязательно в .env: целое 64–8192.
LLM_MAX_COMPLETION_TOKENS=1024
# Путь к файлу с системным промптом (от корня репозитория или абсолютный)
SYSTEM_PROMPT_PATH=prompts/system.txt
# По умолчанию в коде: INFO
LOG_LEVEL=INFO
# Таймаут HTTP к Telegram (сек.), по умолчанию 60. Не устраняет блокировку/отсутствие маршрута из Docker.
# TELEGRAM_HTTP_TIMEOUT=90
